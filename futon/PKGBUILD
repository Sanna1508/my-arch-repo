# Maintainer: <your-maintainer-name> <your-email>
# Contributor: Futon developers <https://github.com/KabosuNeko/Futon>

pkgname=futon
pkgver=1.2.1
pkgrel=1
pkgdesc="TUI manga reader — render manga in the terminal via Kitty Graphics Protocol or Sixel"
arch=('x86_64' 'aarch64')
url="https://github.com/KabosuNeko/Futon"
license=('MIT')
makedepends=('go')
options=('!lto')
source=("futon-${pkgver}.tar.gz::https://github.com/KabosuNeko/Futon/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/Futon-${pkgver}"
  export CGO_ENABLED=0
  go build \
    -trimpath \
    -ldflags "-s -w -X main.Version=${pkgver}" \
    -o futon ./cmd
}

package() {
  cd "${srcdir}/Futon-${pkgver}"

  install -Dm755 futon "${pkgdir}/usr/bin/futon"
  install -Dm644 assets/futon.desktop "${pkgdir}/usr/share/applications/futon.desktop"
  install -Dm644 assets/futon.png "${pkgdir}/usr/share/pixmaps/futon.png"
  install -Dm644 assets/futon.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/futon.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
